{
  "id": "/",
  "name": "VOX London Hub",
  "short_name": "VOX Hub",
  "description": "The working hub for the VOX London founding group.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#3c3c3c",
  "theme_color": "#3c3c3c",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Document store",
      "short_name": "Documents",
      "description": "Papers, minutes and drafts for the Steering Group",
      "url": "/#/documents",
      "icons": [{ "src": "/assets/sc-documents.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Progress",
      "short_name": "Progress",
      "description": "Where VOX London has got to",
      "url": "/#/progress",
      "icons": [{ "src": "/assets/sc-progress.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Suggestions board",
      "short_name": "Suggestions",
      "description": "Ideas from the founding group",
      "url": "/#/suggestions",
      "icons": [{ "src": "/assets/sc-suggestions.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Questions",
      "short_name": "Questions",
      "description": "Ask VOX something, and read the answers",
      "url": "/#/questions",
      "icons": [{ "src": "/assets/sc-questions.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
